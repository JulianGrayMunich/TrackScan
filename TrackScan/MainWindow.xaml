<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" x:Class="TrackScan.MainWindow" xmlns:local="clr-namespace:TrackScan" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="TrackScan" Height="590" Width="960" Background="LightGray" FontFamily="Arial" FontSize="12" ResizeMode="NoResize" Cursor="Arrow" WindowStartupLocation="CenterScreen">
  <!-- #region Main Window Layout -->
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="24" />
    </Grid.RowDefinitions>
    <!-- #region Connection And Configuration -->
    <TabControl x:Name="tabApplication" Grid.Row="0">
      <TabItem Header="Database">
        <Grid Margin="12">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <StackPanel Margin="8">
            <GroupBox Header="Database Connection" Padding="15">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="140" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="15" />
                  <ColumnDefinition Width="130" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Connection string:" VerticalAlignment="Center" />
                <TextBox x:Name="txtConnection" Grid.Column="1" Height="52" FontSize="10" TextWrapping="Wrap" VerticalContentAlignment="Center" TextChanged="ConnectionChanged" />
                <Button Grid.Column="3" Height="28" Content="Test Connection" Click="TestConnection_Click" />
              </Grid>
            </GroupBox>
            <GroupBox Header="DBTrackScan" Padding="15" Margin="0,14,0,0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="180" />
                  <ColumnDefinition Width="230" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Create database:" VerticalAlignment="Center" />
                <Button x:Name="btnCreateScanDb" Grid.Column="1" Width="210" Height="30" HorizontalAlignment="Left" Content="Create DBTrackScan" IsEnabled="False" Click="CreateScanDb_Click" />
              </Grid>
            </GroupBox>
          </StackPanel>
          <GroupBox Grid.Row="1" Header="Comments" Height="129" Padding="8" Margin="0,7,0,0">
            <TextBox x:Name="txtDatabaseComments" IsReadOnly="True" BorderThickness="0" Background="Transparent" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Text="Enter and test the database connection to begin." />
          </GroupBox>
        </Grid>
      </TabItem>
      <TabItem Header="Project Selection">
        <Grid Margin="12">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <GroupBox Header="Project Selection" Margin="8" Padding="15" VerticalAlignment="Top">
            <Grid x:Name="pnlProjectSelection" IsEnabled="False">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="Active project:" VerticalAlignment="Center" />
              <TextBox x:Name="txtActiveProject" Grid.Column="1" Height="28" IsReadOnly="True" VerticalContentAlignment="Center" Text="No active project" />
              <Button Grid.Column="3" Width="150" Height="30" Content="Manage Projects" Click="ManageProjects_Click" />
            </Grid>
          </GroupBox>
          <GroupBox Grid.Row="1" Header="Comments" Height="129" Padding="8" Margin="0,7,0,0">
            <TextBox x:Name="txtConfigurationComments" IsReadOnly="True" BorderThickness="0" Background="Transparent" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Text="Test the database connection before selecting a project." />
          </GroupBox>
        </Grid>
      </TabItem>
      <TabItem x:Name="tabScan" Header="Track Configuration" Selector.Selected="tabScan_Selected">
        <Grid Margin="12">
          <Grid.Resources>
            <Style x:Key="ScanCoordinateCell" TargetType="TextBlock">
              <Setter Property="TextAlignment" Value="Right" />
              <Setter Property="HorizontalAlignment" Value="Stretch" />
            </Style>
          </Grid.Resources>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <DockPanel Margin="0,0,0,8">
            <Button x:Name="btnScanRefresh" DockPanel.Dock="Right" Content="Refresh" Width="85" Height="28" Click="btnScanRefresh_Click" />
            <TextBlock x:Name="txtScanActiveProject" FontWeight="Bold" VerticalAlignment="Center" Text="No active project selected." TextTrimming="CharacterEllipsis" />
          </DockPanel>
          <TabControl x:Name="pnlScanWorkspace" Grid.Row="1" IsEnabled="False">
            <TabItem x:Name="tabScanSurvey" Header="Railhead Survey" Selector.Selected="ScanningPage_Selected">
              <Grid Margin="10">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="1" Margin="0,0,0,7">
                  <Button x:Name="btnScanSelectCsv" DockPanel.Dock="Left" Content="Select CSV..." Width="110" Height="28" Click="btnScanSelectCsv_Click" />
                  <CheckBox x:Name="chkScanHeader" DockPanel.Dock="Left" Content="Includes header row" Margin="15,0" VerticalAlignment="Center" IsChecked="False" Checked="chkScanHeader_Changed" Unchecked="chkScanHeader_Changed" />
                  <Button x:Name="btnScanImport" DockPanel.Dock="Right" Content="Save" Visibility="Collapsed" Width="75" Height="28" Click="btnScanImport_Click" IsEnabled="False" />
                  <Button x:Name="btnScanCancelPreview" DockPanel.Dock="Right" Content="Cancel" Visibility="Collapsed" Width="75" Height="28" Margin="6,0" Click="btnScanCancelPreview_Click"/>
                  <TextBlock x:Name="txtScanFile" Text="No CSV selected." TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                </DockPanel>
                <DataGrid x:Name="dgScanPreview" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" EnableRowVirtualization="True" HeadersVisibility="Column" MinHeight="80">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Record" Binding="{Binding Record}" Width="55" />
                    <DataGridTextColumn Header="Point name" Binding="{Binding PointName}" Width="110" />
                    <DataGridTextColumn Header="Easting (m)" Binding="{Binding Easting}" ElementStyle="{StaticResource ScanCoordinateCell}" Width="130" />
                    <DataGridTextColumn Header="Northing (m)" Binding="{Binding Northing}" ElementStyle="{StaticResource ScanCoordinateCell}" Width="130" />
                    <DataGridTextColumn Header="Railhead Height (m)" Binding="{Binding Height}" Width="145" />
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*" MinWidth="200" />
                  </DataGrid.Columns>
                </DataGrid>
              </Grid>
            </TabItem>
            <TabItem x:Name="tabScanTracks" Header="Tracks" IsEnabled="False" Selector.Selected="ScanningPage_Selected">
              <Grid Margin="10">
                <Grid.RowDefinitions>
                  <RowDefinition Height="*" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="280" />
                  <ColumnDefinition Width="15" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                  </Grid.RowDefinitions>
                  <TextBlock x:Name="txtScanTrackCount" Text="0 of 6 tracks" Margin="0,0,0,7" />
                  <DataGrid x:Name="dgScanTracks" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column" SelectionChanged="dgScanTracks_SelectionChanged">
                    <DataGrid.Columns>
                      <DataGridTextColumn Header="Track" Binding="{Binding Slot}" Width="50" />
                      <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" MinWidth="110" />
                      <DataGridTextColumn Header="Gauge (mm)" Binding="{Binding GaugeMillimetres}" Width="80" />
                    </DataGrid.Columns>
                  </DataGrid>
                </Grid>
                <StackPanel Grid.Column="2">
                  <TextBlock x:Name="txtScanEditorTitle" Text="New track" FontWeight="Bold" Margin="0,0,0,3" />
                  <DockPanel Width="432" HorizontalAlignment="Left" Margin="0,0,0,5">
                    <TextBlock Text="Track name:" Width="100" VerticalAlignment="Center" />
                    <TextBox x:Name="txtScanTrackName" MaxLength="200" Height="27" TextChanged="ScanTrack_TextChanged" />
                  </DockPanel>
                  <!-- #region TRACK GAUGE AND ENDPOINTS -->
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                    <TextBlock Text="Gauge:" Width="50" VerticalAlignment="Center" />
                    <RadioButton x:Name="rbScanGauge1435" Content="1435 mm" GroupName="ScanGauge" IsChecked="False" Checked="ScanGauge_Checked" VerticalAlignment="Center" Margin="4,0,18,0" />
                    <RadioButton x:Name="rbScanGauge1600" Content="1600 mm" GroupName="ScanGauge" IsChecked="True" Checked="ScanGauge_Checked" VerticalAlignment="Center" />
                    <TextBlock Text="Railhead spacing: 3.000 m (fixed)" Margin="18,0,0,0" VerticalAlignment="Center" />
                  </StackPanel>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="180" />
                      <ColumnDefinition Width="128" />
                      <ColumnDefinition Width="128" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="21" />
                      <RowDefinition Height="28" />
                      <RowDefinition Height="28" />
                      <RowDefinition Height="28" />
                      <RowDefinition Height="28" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Column="1" Text="Easting (m)" TextAlignment="Right" Margin="4,0" />
                    <TextBlock Grid.Column="2" Text="Northing (m)" TextAlignment="Right" Margin="4,0" />
                    <TextBlock Grid.Row="1" Text="Start: Primary rail" HorizontalAlignment="Stretch" TextAlignment="Right" VerticalAlignment="Center" />
                    <TextBox x:Name="txtScanRightStartE" Grid.Row="1" Grid.Column="1" Width="120" HorizontalAlignment="Left" TextAlignment="Right" Margin="4,3" TextChanged="ScanTrack_TextChanged" LostFocus="ScanCoordinate_LostFocus" />
                    <TextBox x:Name="txtScanRightStartN" Grid.Row="1" Grid.Column="2" Width="120" HorizontalAlignment="Left" TextAlignment="Right" Margin="4,3" TextChanged="ScanTrack_TextChanged" LostFocus="ScanCoordinate_LostFocus" />
                    <Button x:Name="btnScanImportEndpoints" Grid.Row="1" Grid.Column="3" Content="Import CSV" Width="100" Height="22" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0,0,0" Click="btnScanImportEndpoints_Click" />
                    <TextBlock Grid.Row="2" Text="Start: Secondary rail" HorizontalAlignment="Stretch" TextAlignment="Right" VerticalAlignment="Center" />
                    <TextBox x:Name="txtScanLeftStartE" Grid.Row="2" Grid.Column="1" Width="120" HorizontalAlignment="Left" TextAlignment="Right" Margin="4,3" TextChanged="ScanTrack_TextChanged" LostFocus="ScanCoordinate_LostFocus" />
                    <TextBox x:Name="txtScanLeftStartN" Grid.Row="2" Grid.Column="2" Width="120" HorizontalAlignment="Left" TextAlignment="Right" Margin="4,3" TextChanged="ScanTrack_TextChanged" LostFocus="ScanCoordinate_LostFocus" />
                    <TextBlock Grid.Row="3" Text="End: Primary rail" HorizontalAlignment="Stretch" TextAlignment="Right" VerticalAlignment="Center" />
                    <TextBox x:Name="txtScanRightEndE" Grid.Row="3" Grid.Column="1" Width="120" HorizontalAlignment="Left" TextAlignment="Right" Margin="4,3" TextChanged="ScanTrack_TextChanged" LostFocus="ScanCoordinate_LostFocus" />
                    <TextBox x:Name="txtScanRightEndN" Grid.Row="3" Grid.Column="2" Width="120" HorizontalAlignment="Left" TextAlignment="Right" Margin="4,3" TextChanged="ScanTrack_TextChanged" LostFocus="ScanCoordinate_LostFocus" />
                    <TextBlock Grid.Row="4" Text="End: Secondary rail" HorizontalAlignment="Stretch" TextAlignment="Right" VerticalAlignment="Center" />
                    <TextBox x:Name="txtScanLeftEndE" Grid.Row="4" Grid.Column="1" Width="120" HorizontalAlignment="Left" TextAlignment="Right" Margin="4,3" TextChanged="ScanTrack_TextChanged" LostFocus="ScanCoordinate_LostFocus" />
                    <TextBox x:Name="txtScanLeftEndN" Grid.Row="4" Grid.Column="2" Width="120" HorizontalAlignment="Left" TextAlignment="Right" Margin="4,3" TextChanged="ScanTrack_TextChanged" LostFocus="ScanCoordinate_LostFocus" />
                  </Grid>
                  <!-- #endregion -->
                </StackPanel>
                <!-- #region TRACK ACTION ROW -->
                <Button x:Name="btnScanNewTrack" Grid.Row="1" Content="New track" Width="110" Height="28" HorizontalAlignment="Left" Margin="0,8,0,0" Click="btnScanNewTrack_Click" />
                <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Margin="0,8,0,0">
                  <Button x:Name="btnScanSaveTrack" Content="Save track" Width="100" Height="28" Click="btnScanSaveTrack_Click" />
                  <Button Content="Cancel edits" Width="100" Height="28" Margin="8,0" Click="btnScanCancelTrack_Click" />
                  <Button x:Name="btnScanDeleteTrack" Content="Delete track" Width="100" Height="28" Click="btnScanDeleteTrack_Click" />
                  <Button x:Name="btnScanCompute" Content="Compute Railhead Points" Width="155" Height="28" Margin="8,0,0,0" Click="btnScanCompute_Click" />
                </StackPanel>
                <!-- #endregion -->
                <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,8,0,0">


                </StackPanel>
              </Grid>
            </TabItem>
<TabItem x:Name="tabScanPolygons" Header="Polygons" Selector.Selected="ScanningPage_Selected">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="12">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <TextBlock Text="Track:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <ComboBox x:Name="cmbPolygonTrack" Width="280" Height="26" DisplayMemberPath="TrackName" SelectionChanged="cmbPolygonTrack_SelectionChanged"/>
                                    </StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <GroupBox Header="Rail Corridor polygon" Padding="10">
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="32"/></Grid.RowDefinitions>
                                                <TextBlock Text="Corridor width (m):" VerticalAlignment="Center"/>
                                                <ComboBox x:Name="cmbCorridorWidth" Grid.Column="1" Height="25"/>
                                                <TextBlock Grid.Row="1" Text="Colinearity limit (m):" VerticalAlignment="Center"/>
                                                <ComboBox x:Name="cmbCollinearity" DisplayMemberPath="Label" SelectedValuePath="Value" Grid.Row="1" Grid.Column="1" Height="25"/>
                                            </Grid>
                                        </GroupBox>
                                        <GroupBox Grid.Column="2" Header="Railhead polygons" Padding="10">
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="32"/><RowDefinition Height="32"/></Grid.RowDefinitions>
                                                <TextBlock Text="Polygon width (m):" VerticalAlignment="Center"/>
                                                <ComboBox x:Name="cmbHeadWidth" Grid.Column="1" Height="25"/>
                                                <TextBlock Grid.Row="1" Text="Polygon length (m):" VerticalAlignment="Center"/>
                                                <ComboBox x:Name="cmbHeadLength" Grid.Row="1" Grid.Column="1" Height="25"/>
                                                <TextBlock Grid.Row="2" Text="Height filter (mm):" VerticalAlignment="Center"/>
                                                <ComboBox x:Name="cmbHeightFilter" Grid.Row="2" Grid.Column="1" Height="25"/>
                                            </Grid>
                                        </GroupBox>
                                    </Grid>
                                    <Button x:Name="btnCreatePolygons" Content="Compute Polygons" Width="145" Height="28" HorizontalAlignment="Left" Margin="0,14,0,0" Click="btnCreatePolygons_Click"/>
                                <CheckBox x:Name="chkPolygonExportCsv" Content="Export polygon points to CSV" IsChecked="True" Margin="0,10,0,0"/>
                                </StackPanel>
                                </ScrollViewer>
                            </TabItem>
                            <TabItem x:Name="tabScanProcessing" Header="Compute Offsets" Selector.Selected="ScanningPage_Selected">
                                <Grid Margin="12">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                    <DockPanel Margin="0,0,0,8">
                                        <Button x:Name="btnSelectProcessingLas" Content="Select LAS files" Width="140" Height="28" Margin="0,0,10,0" Click="btnProcessingBrowse_Click"/>
                                        <TextBox x:Name="txtProcessingFile" IsReadOnly="True" VerticalContentAlignment="Center"/>
                                    </DockPanel>
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="Scan timestamp (UTC):" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBox x:Name="txtProcessingEpoch" Width="155" Height="26" IsReadOnly="True" VerticalContentAlignment="Center"/>
                                        <StackPanel Orientation="Horizontal" Margin="15,0,0,0">
                                            <TextBlock Text="Rejection count:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <ComboBox x:Name="cmbProcessingRejectionCount" Width="75" Height="28" SelectedIndex="2">
                                                <ComboBoxItem Content="10"/><ComboBoxItem Content="25"/><ComboBoxItem Content="50"/><ComboBoxItem Content="75"/><ComboBoxItem Content="100"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <Button x:Name="btnProcessScan" Content="Compute Offsets" Width="130" Height="28" Margin="25,0,0,0" Click="btnProcessScan_Click"/>
                                        <Button x:Name="btnCancelProcessing" Content="Cancel" Width="85" Height="28" Margin="10,0,0,0" Visibility="Collapsed" Click="btnCancelProcessing_Click"/>
                                    </StackPanel>
                                    <DockPanel Grid.Row="2" Margin="0,0,0,8">

                                        <CheckBox x:Name="chkProcessingAll" Content="All tracks" Width="95" VerticalAlignment="Center" Click="chkProcessingAll_Click"/>
                                        <CheckBox x:Name="chkDisplayDataChart" DockPanel.Dock="Right" Content="Display data chart" IsChecked="False" VerticalAlignment="Center" Margin="15,0,0,0"/>
                                        <ComboBox x:Name="cmbProcessingTracks" Height="28" MaxWidth="420" HorizontalAlignment="Left" MinWidth="250" DisplayMemberPath="TrackName" SelectionChanged="cmbProcessingTracks_SelectionChanged"/>
                                    </DockPanel>
                                    
                                    <DockPanel x:Name="pnlCalibrationFiles" Grid.Row="3" Margin="0,0,0,8">
                                        <StackPanel DockPanel.Dock="Right" Margin="10,0,0,0">
                                            <Button x:Name="btnCalibrationAdd" Content="Add files" Width="125" Margin="0,0,0,5" Click="btnProcessingBrowse_Click"/>
                                            <Button x:Name="btnCalibrationRemove" Visibility="Collapsed" Content="Remove selected" Width="125" Margin="0,0,0,5" Click="CalibrationRemove_Click"/>
                                            <Button x:Name="btnCalibrationClear" Visibility="Collapsed" Content="Clear list" Width="125" Click="CalibrationClear_Click"/>
                                            <Button x:Name="btnReviewStoredOffsets" Content="Review offsets" Width="125" Margin="0,5,0,0" Click="ReviewStoredOffsets_Click"/>
                                        </StackPanel>
                                        <DataGrid x:Name="gridCalibrationFiles" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Extended">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="LAS file" Binding="{Binding FileName}" Width="*" MinWidth="200"/>
                                                <DataGridTextColumn Header="Observation time (UTC)" Binding="{Binding Timestamp}" Width="180" MinWidth="180"/>
                                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="230" MinWidth="230"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </DockPanel>

                                </Grid>
                            </TabItem>
                                      </TabControl>
          <!-- #region SCANNING COMMENTS -->
          <GroupBox x:Name="grpScanningComments" Grid.Row="2" Header="Comments" Height="129" Padding="8" Margin="0,7,0,0">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <ProgressBar x:Name="barScanProgress" Height="4" IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,0,4" />
              <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                  <StackPanel.Resources>
                    <Style TargetType="TextBox">
                      <Setter Property="IsReadOnly" Value="True" />
                      <Setter Property="BorderThickness" Value="0" />
                      <Setter Property="Background" Value="Transparent" />
                      <Setter Property="TextWrapping" Value="Wrap" />
                      <Setter Property="AcceptsReturn" Value="True" />
                      <Setter Property="VerticalContentAlignment" Value="Top" />
                    </Style>
                  </StackPanel.Resources>
                  <TextBox x:Name="txtProcessingTimestampSource" Visibility="Collapsed"/>
                  <TextBox x:Name="txtScanStatus" Text="" />
                  <TextBox x:Name="txtScanGuidance" Text="" />
                  <TextBox x:Name="txtScanEndpointCsvInstructions" Text="Endpoint CSV: point name, E, N, Ht coordinates (metres), with four data rows and no header. Row order: Primary Start, Primary End, Secondary Start, Secondary End. Only E and N are imported; review the coordinates, then Save track." />
                  <StackPanel x:Name="pnlScanSurveyComments" Visibility="Collapsed">
                    <TextBox x:Name="txtScanCurrentSurvey" Text="No Railhead survey loaded." />
                    <TextBox x:Name="txtScanPreviewStatus" Text="Select a CSV to review all records before saving." />
                    <TextBox x:Name="txtScanErrors" Foreground="DarkRed" />
                  </StackPanel>
                </StackPanel>
              </ScrollViewer>
            </Grid>
          </GroupBox>
          <!-- #endregion -->
        </Grid>
      </TabItem>
<TabItem x:Name="tabScanScheduler" Header="Scan Scheduler" Selector.Selected="ScanScheduler_Selected">
                                <Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="129"/></Grid.RowDefinitions>
<ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12">
                                    <TextBlock x:Name="txtSchedulerCountdown" Text="Scheduler Stopped" Margin="0,0,0,12" FontSize="22" FontWeight="Bold"/>
                                    
                                    
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/><ColumnDefinition Width="95"/></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="32"/><RowDefinition Height="32"/><RowDefinition Height="32"/></Grid.RowDefinitions>
                                        <TextBlock Text="Incoming LAS folder:" VerticalAlignment="Center"/><TextBox VerticalContentAlignment="Center" x:Name="txtSchedulerInput" Grid.Column="1" Margin="0,2,8,2"/><Button Grid.Column="2" Content="Browse..." Tag="Input" Click="SchedulerBrowse_Click" Margin="0,2,0,2"/>
                                        <TextBlock Grid.Row="1" Text="Processed folder:" VerticalAlignment="Center"/><TextBox VerticalContentAlignment="Center" x:Name="txtSchedulerProcessed" Grid.Row="1" Grid.Column="1" Margin="0,2,8,2"/><Button Grid.Row="1" Grid.Column="2" Content="Browse..." Tag="Processed" Click="SchedulerBrowse_Click" Margin="0,2,0,2"/>
                                        <TextBlock Grid.Row="2" Text="System log file:" VerticalAlignment="Center"/><TextBox VerticalContentAlignment="Center" x:Name="txtSchedulerLog" Grid.Row="2" Grid.Column="1" Margin="0,2,8,2"/><Button Grid.Row="2" Grid.Column="2" Content="Browse..." Tag="Log" Click="SchedulerBrowse_Click" Margin="0,2,0,2"/>
                                        <TextBlock Grid.Row="3" Text="Start (project local time):" VerticalAlignment="Center"/>
                                        <Grid Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2"><Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<DatePicker x:Name="dpSchedulerStart" SelectedDateChanged="SchedulerDate_Changed"/>
<TextBlock Grid.Column="1" Text="Server time zone:" HorizontalAlignment="Right" Margin="12,0,10,0" VerticalAlignment="Center"/>
<ComboBox Grid.Column="2" x:Name="cmbSchedulerServerZone" DisplayMemberPath="DisplayName" SelectedValuePath="Id" SelectionChanged="SchedulerServerZone_Changed" VerticalContentAlignment="Center"/>
</Grid></Grid>
<Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="145"/><ColumnDefinition Width="*"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions>
<StackPanel HorizontalAlignment="Right" Margin="0,0,15,0"><Viewbox Width="85" Height="85"><local:ScheduleClock x:Name="SchedulerClock" TimeChanged="SchedulerClockTime_Changed"/></Viewbox>
<StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><RadioButton x:Name="SchedulerAm" Content="AM" GroupName="SchedulerPeriod" IsChecked="True" Checked="SchedulerPeriod_Changed" Margin="0,2,12,0"/><RadioButton x:Name="SchedulerPm" Content="PM" GroupName="SchedulerPeriod" Checked="SchedulerPeriod_Changed" Margin="0,2,0,0"/></StackPanel></StackPanel>
<StackPanel Grid.Column="1"><TextBox x:Name="txtSchedulerStartTime" TextChanged="SchedulerTimeText_Changed" Width="75" Height="28" Text="00:00" HorizontalAlignment="Right" VerticalContentAlignment="Center"/>
<StackPanel Orientation="Horizontal" Margin="0,12,0,0" HorizontalAlignment="Right"><TextBlock Text="Every:" VerticalAlignment="Center"/><ComboBox x:Name="cmbSchedulerInterval" Width="75" SelectedIndex="3" VerticalContentAlignment="Center" Margin="8,0,15,0"><ComboBoxItem Content="5min" Tag="5"/><ComboBoxItem Content="15min" Tag="15"/><ComboBoxItem Content="30min" Tag="30"/><ComboBoxItem Content="1hr" Tag="60"/><ComboBoxItem Content="2hr" Tag="120"/><ComboBoxItem Content="3hr" Tag="180"/><ComboBoxItem Content="4hr" Tag="240"/><ComboBoxItem Content="6hr" Tag="360"/><ComboBoxItem Content="12hr" Tag="720"/><ComboBoxItem Content="24hr" Tag="1440"/></ComboBox></StackPanel></StackPanel>
<StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="20,0,0,0"><TextBlock Text="Rejection count:" VerticalAlignment="Center"/><ComboBox x:Name="cmbSchedulerRejection" Width="65" SelectedIndex="2" Margin="8,0,0,0"><ComboBoxItem Content="10"/><ComboBoxItem Content="25"/><ComboBoxItem Content="50"/><ComboBoxItem Content="75"/><ComboBoxItem Content="100"/></ComboBox></StackPanel>
<Button Grid.Column="3" Content="Update Railhead Names" Width="160" Height="30" VerticalAlignment="Top" Click="SchedulerNames_Click"/>
</Grid>
<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0"><Button Content="Save Settings" Width="115" Height="30" Click="SchedulerSave_Click" Margin="0,0,8,0"/><Button Content="Start" Width="70" Height="30" Click="SchedulerStart_Click" Margin="0,0,8,0"/><Button Content="Stop" Width="70" Height="30" Click="SchedulerStop_Click"/></StackPanel>
                                </StackPanel></ScrollViewer>
<GroupBox Grid.Row="1" Header="Comments" Padding="8" Margin="0,7,0,0"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock x:Name="txtSchedulerTimeConversion" TextWrapping="Wrap" Margin="0,0,0,6"/><TextBlock x:Name="txtSchedulerServiceStatus" TextWrapping="Wrap" Margin="0,4,0,8"/><TextBlock x:Name="txtSchedulerSummary" TextWrapping="Wrap" Margin="0,0,0,8"/><TextBlock TextWrapping="Wrap" Text="Temporary test mode: each scheduled run waits five seconds. No LAS files are processed or moved and no readings are written. Keep TrackScan open and visit this tab to display the placeholder flyout. The saved interval remains anchored to the start time. Start requires administrator approval and your Windows password (not a PIN)."/><TextBox VerticalContentAlignment="Center" x:Name="txtSchedulerComments" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent"/></StackPanel></ScrollViewer></GroupBox></Grid>
                            </TabItem>
<TabItem x:Name="tabSettings" Header="Data Verification">
                    <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="129"/></Grid.RowDefinitions><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="8">
                        <GroupBox Header="Tickboxes" Padding="12" Margin="0,0,0,15">
                            <StackPanel>
                                <CheckBox x:Name="chkRailheadToRComparison" Content="Railhead Points vs ToR Points" IsChecked="False" Margin="0,0,0,12"/>
                                <CheckBox x:Name="chkDebugging" Content="Debugging" IsChecked="True" Checked="chkDebugging_Changed" Unchecked="chkDebugging_Changed"/>
                                <StackPanel x:Name="pnlDebugOptions" Visibility="Visible" Margin="20,12,0,0">
                                    <CheckBox x:Name="chkScanExportCsv" Content="Export railhead and polygon checking CSV files" IsChecked="True"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="Data Verification" Padding="12">
                            <StackPanel>
                                <Button x:Name="btnInspectLas" Content="Inspect LAS coordinates" Width="190" Height="30" HorizontalAlignment="Left" Margin="0,0,0,10" Click="btnInspectLas_Click"/>
                                <Button x:Name="btnScanCoverage" Content="Check scan coverage" Width="190" Height="30" HorizontalAlignment="Left" Margin="0,0,0,10" Click="btnScanCoverage_Click"/>
                                <Button x:Name="btnCancelCoverage" Content="Cancel coverage check" Width="190" Height="28" HorizontalAlignment="Left" Visibility="Collapsed" Click="btnCancelCoverage_Click"/>

                            </StackPanel>
                        </GroupBox>
                    </StackPanel></ScrollViewer>
<GroupBox Grid.Row="1" Header="Comments" Padding="8" Margin="0,7,0,0"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
<TextBlock TextWrapping="Wrap" Text="Inspect LAS coordinates shows the first 100 records with scale and offset applied. Check scan coverage compares current railhead points with the plan footprint; coverage does not guarantee usable railhead returns. These tools remain available whether Debugging is ticked or unticked."/>
<TextBlock x:Name="txtCoverageStatus" TextWrapping="Wrap" Margin="0,5,0,0"/>
</StackPanel></ScrollViewer></GroupBox></Grid></TabItem>
    </TabControl>
    <!-- #endregion -->
    <!-- #region Copyright Footer -->
    <TextBlock x:Name="extras_tbCopyright" Grid.Row="1" Margin="9,0,0,4" HorizontalAlignment="Left" VerticalAlignment="Center" TextAlignment="Left" FontFamily="Century Gothic" FontSize="9" Foreground="DarkSlateGray" Text="{Binding CopyrightText, RelativeSource={RelativeSource AncestorType=Window}}" />
    <!-- #endregion -->
  </Grid>
  <!-- #endregion -->
</Window>
