<Window x:Class="TrackScan.ScanLasPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LAS coordinate inspection — first 100 records" Width="860" Height="600"
        MinWidth="650" MinHeight="400" WindowStartupLocation="CenterOwner">
    <Grid Margin="14">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBox x:Name="txtSource" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Margin="0,0,0,8"/>
        <TextBox x:Name="txtDetails" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Margin="0,0,0,10"/>
        <DataGrid x:Name="gridLasPoints" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False" SelectionUnit="CellOrRowHeader">
            <DataGrid.Resources><Style x:Key="CoordinateCell" TargetType="TextBlock"><Setter Property="TextAlignment" Value="Right"/></Style></DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Record" Binding="{Binding Record}" Width="80"/>
                <DataGridTextColumn Header="Easting" Binding="{Binding Easting, StringFormat=F3}" ElementStyle="{StaticResource CoordinateCell}" Width="*"/>
                <DataGridTextColumn Header="Northing" Binding="{Binding Northing, StringFormat=F3}" ElementStyle="{StaticResource CoordinateCell}" Width="*"/>
                <DataGridTextColumn Header="Height" Binding="{Binding Height, StringFormat=F3}" ElementStyle="{StaticResource CoordinateCell}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
        <Button Grid.Row="3" Content="Close" Width="100" Height="28" HorizontalAlignment="Right" Margin="0,12,0,0" IsCancel="True"/>
    </Grid>
</Window>
