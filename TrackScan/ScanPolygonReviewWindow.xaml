<Window x:Class="TrackScan.ScanPolygonReviewWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Review rail polygons" Width="900" Height="560" MinWidth="750" MinHeight="400" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="LightGray" FontFamily="Arial" FontSize="12">
 <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock x:Name="txtSummary" TextWrapping="Wrap" Margin="0,0,0,12"/>
  <DataGrid x:Name="gridVertices" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" EnableRowVirtualization="True" HeadersVisibility="Column">
   <DataGrid.Resources><Style x:Key="Number" TargetType="TextBlock"><Setter Property="TextAlignment" Value="Right"/><Setter Property="Margin" Value="4,0"/></Style></DataGrid.Resources>
   <DataGrid.Columns>
    <DataGridTextColumn Header="Identifier" Binding="{Binding Identifier}" Width="2*"/>
    <DataGridTextColumn Header="Railhead point" Binding="{Binding RailheadPoint}" Width="*"/>
    <DataGridTextColumn Header="E (m)" Binding="{Binding Easting, StringFormat=F3}" Width="*" ElementStyle="{StaticResource Number}"/>
    <DataGridTextColumn Header="N (m)" Binding="{Binding Northing, StringFormat=F3}" Width="*" ElementStyle="{StaticResource Number}"/>
    <DataGridTextColumn Header="Ht (m)" Binding="{Binding Height, StringFormat=F3}" Width="90" ElementStyle="{StaticResource Number}"/>
   </DataGrid.Columns>
  </DataGrid>
  <TextBlock Grid.Row="2" Text="Vertices are listed in boundary order. Each polygon closes from its last vertex to its first. Display: 3 decimals; storage and CSV: 4 decimals. Cancel leaves the database unchanged." TextWrapping="Wrap" Margin="0,12"/>
  <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="btnSave" Content="Save and export CSV" Width="155" Height="28" Margin="0,0,10,0" Click="Save_Click"/><Button Content="Cancel" Width="90" Height="28" IsCancel="True" IsDefault="True"/></StackPanel>
 </Grid>
</Window>
