<Window x:Class="TrackScan.ProjectManagementWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Project Management" Width="920" Height="560" MinWidth="920" MinHeight="560" WindowStartupLocation="CenterOwner"
 Background="LightGray" FontFamily="Arial" FontSize="12" ShowInTaskbar="False">
 <!-- #region Project Management Layout -->
 <Grid Margin="15" x:Name="pnlManagement">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="85"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,12">
   <Button DockPanel.Dock="Right" Content="Close" Width="80" Height="28" Click="Close_Click"/>
   <Button DockPanel.Dock="Right" Content="Refresh" Width="80" Margin="0,0,10,0" Click="Refresh_Click"/>
   <TextBlock Text="Project Management" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
  </DockPanel>
  <Grid Grid.Row="1" Margin="0,0,0,12">
   <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/><ColumnDefinition Width="115"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <TextBlock Text="New project:" VerticalAlignment="Center"/>
   <TextBox x:Name="txtName" Grid.Column="1" Height="28" MaxLength="200" VerticalContentAlignment="Center" TextChanged="RequiredChanged"/>
   <DatePicker x:Name="dpStart" Grid.Column="2" Height="28" Margin="8,0,0,0" SelectedDateChanged="RequiredChanged" CalendarOpened="CalendarOpened" CalendarClosed="CalendarClosed"/>
   <Button Grid.Column="3" Margin="8,0,0,0" Content="Project Start" Click="Start_Click"/>
   <Button Grid.Column="4" Margin="8,0,0,0" x:Name="btnAdd" Content="Add Project" Click="Add_Click" IsEnabled="False"/>
   <TextBlock Grid.Row="1" Text="Project time zone:" Margin="0,10,0,0" VerticalAlignment="Center"/>
   <ComboBox x:Name="cmbZone" Grid.Row="1" Grid.Column="1" Height="28" Margin="0,10,0,0" DisplayMemberPath="DisplayName" SelectedValuePath="Id" SelectionChanged="RequiredChanged"/>
   <Button Grid.Row="1" Grid.Column="2" Content="Output Path..." Margin="8,10,0,0" Click="Output_Click"/>
   <TextBox x:Name="txtOutput" Grid.Row="1" Grid.Column="3" Margin="8,10,0,0" Height="28" IsReadOnly="True" VerticalContentAlignment="Center" TextChanged="RequiredChanged"/>
   <Button Grid.Row="1" Grid.Column="4" Content="Save Settings" Margin="8,10,0,0" Click="SaveSettings_Click"/>
  </Grid>
  <DataGrid x:Name="dgProjects" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
   CanUserReorderColumns="False" CanUserResizeRows="False" SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column"
   SelectionChanged="ProjectSelected">
   <DataGrid.Columns>
    <DataGridTemplateColumn Header="Active" Width="70"><DataGridTemplateColumn.CellTemplate><DataTemplate>
     <RadioButton GroupName="ActiveProject" IsChecked="{Binding IsActive,Mode=OneWay}" HorizontalAlignment="Center" Click="Active_Click">
      <RadioButton.Style><Style TargetType="RadioButton"><Style.Triggers><DataTrigger Binding="{Binding IsDeleted}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></RadioButton.Style>
     </RadioButton>
    </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
    <DataGridTemplateColumn Header="Project Name" Width="*" MinWidth="260"><DataGridTemplateColumn.CellTemplate><DataTemplate>
     <TextBox Text="{Binding Name,Mode=OneWay}" MaxLength="200" BorderThickness="0" Background="Transparent" LostKeyboardFocus="Rename_LostFocus"/>
    </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
    <DataGridTextColumn Header="Project Start Date" Binding="{Binding StartDate,StringFormat=yyyy-MM-dd}" Width="145" IsReadOnly="True"/>
    <DataGridTemplateColumn Header="Deleted" Width="90"><DataGridTemplateColumn.CellTemplate><DataTemplate>
     <CheckBox IsChecked="{Binding IsDeleted,Mode=OneWay}" HorizontalAlignment="Center" Click="Deleted_Click">
      <CheckBox.Style><Style TargetType="CheckBox"><Style.Triggers><DataTrigger Binding="{Binding IsActive}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></CheckBox.Style>
     </CheckBox>
    </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
   </DataGrid.Columns>
  </DataGrid>
  <GroupBox Grid.Row="3" Header="Comments" Margin="0,8,0,0" Padding="5"><TextBox x:Name="txtStatus" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></GroupBox>
 </Grid>
 <!-- #endregion -->
</Window>
